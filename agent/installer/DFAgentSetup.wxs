<?xml version="1.0" encoding="utf-8"?>
<!--
  Bo cai Windows Installer (.msi) cho DF Local Agent - dong goi bang WiX Toolset v5.
  Dung dinh dang MSI + ServiceInstall/ServiceControl native (khong shell ra sc.exe an cua
  so nhu ban Inno Setup .exe) de giam nguy co bi Windows Defender gan nhan heuristic
  "dropper" (Program:Win32/Wacapew.A!ml) - xem session-log.md muc lien quan toi 404 tai
  cong cu DF Agent (2026-07-29).

  KHONG con man hinh cau hinh, KHONG con Custom Action sinh appsettings.json luc cai (da bo
  sau khi gap MSI error 1721 "A program run as part of the setup did not finish as expected"
  tren may that 2026-07-30 — deferred Custom Action goi PowerShell qua token [~] khong dang
  tin cay bang, kho debug tu xa). Vi StationId da co dong san luc build (khong con nguoi
  dung nhap gi ca), don gian hon nhieu la dong goi THANG 1 file appsettings.<role>.json tinh
  co san (xem agent/installer/appsettings.print-station.json,
  appsettings.weighing-printer.json, appsettings.weighing-scale.json) qua bien tien xu ly
  AppSettingsFile — khong can Custom Action nao het ngoai ServiceInstall/ServiceControl
  native cua MSI.

  Build 3 file MSI rieng tu cung file .wxs nay qua StationId + AppSettingsFile
  (xem agent/installer/build-all.ps1):
    wix build DFAgentSetup.wxs -ext WixToolset.UI.wixext ^
      -d StationId=WS-PRINT-STATION -d AppSettingsFile=appsettings.print-station.json ^
      -o DFAgentSetup-PrintStation.msi

  Khong con Token — backend (AgentAuth middleware) tu tao/nhan Workstation theo
  workstation_id khi khong co token, danh doi bao mat da duoc nguoi dung xac nhan (xem
  session-log.md).
-->
<?ifndef StationId?>
<?define StationId = "WS-PRINT-STATION"?>
<?endif?>
<?ifndef AppSettingsFile?>
<?define AppSettingsFile = "appsettings.print-station.json"?>
<?endif?>
<?ifndef PackageVersion?>
<?define PackageVersion = "1.4.0.0"?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DF Local Agent ($(var.StationId))"
           Manufacturer="DF Factory Systems"
           Version="$(var.PackageVersion)"
           UpgradeCode="CD108F1A-FCE9-46F2-B991-372D89E0E9D1"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <!-- Ca 3 vai tro (Print Station/Weighing Printer/Weighing Scale) dung chung 1
         UpgradeCode co y: 1 may vat ly chi duoc dung DUNG 1 vai tro tai 1 thoi diem —
         cai vai tro khac se THAY THE (uninstall+install) vai tro cu thay vi chay song
         song 2 service "DFAgent" chong ten nhau. Moi vai tro co PackageVersion RIENG
         (xem build-all.ps1) de MSI luon nhan ra la "phien ban khac" du doi qua lai giua
         3 vai tro theo huong nao — AllowDowngrades="yes" vi thu tu version khong phan
         anh "moi/cu" thuc su, chi la nhan dang vai tro khac nhau. Phat hien loi thuc te
         2026-07-30: 3 file ban dau cung Version 1.4.0.0 nen cai WeighingPrinter tren may
         da co PrintStation bi MSI coi la "da cai roi", khong thay the gi ca. -->
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DFAgent" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="..\publish_release\**">
        <Exclude Files="..\publish_release\DFAgent.exe" />
        <Exclude Files="..\publish_release\appsettings.json" />
      </Files>
    </ComponentGroup>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="57612DD8-1695-4C9D-BA12-50A1C09E972E" Bitness="always64">
      <File Id="DFAgentExe" Source="..\publish_release\DFAgent.exe" KeyPath="yes" />

      <ServiceInstall Id="DFAgentServiceInstall"
                      Name="DFAgent"
                      DisplayName="DF Local Agent"
                      Description="Bao cao may in/can, in tem TSPL cho he thong DF (khong dung dau co dau de tranh loi encoding Service Control Manager)."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem" />

      <ServiceControl Id="DFAgentServiceControl"
                       Name="DFAgent"
                       Start="install"
                       Stop="both"
                       Remove="uninstall"
                       Wait="yes" />
    </Component>

    <!-- appsettings.json tinh, dong san dung role/ma tram theo bien AppSettingsFile luc
         build — khong sinh dong luc cai nua (xem ghi chu dau file). -->
    <Component Id="AppSettingsConfig" Directory="INSTALLFOLDER" Guid="AEDB51B0-A39F-498D-9C25-BF8E612DF1E0" Bitness="always64">
      <File Id="AppSettingsJson" Name="appsettings.json" Source="$(var.AppSettingsFile)" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="DF Local Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppSettingsConfig" />
    </Feature>

    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <UI>
    <UIRef Id="WixUI_Common" />

    <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
    <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
    <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

    <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <DialogRef Id="ErrorDlg" />
    <DialogRef Id="ExitDialog" />
    <DialogRef Id="FatalError" />
    <DialogRef Id="FilesInUse" />
    <DialogRef Id="MsiRMFilesInUse" />
    <DialogRef Id="PrepareDlg" />
    <DialogRef Id="ProgressDlg" />
    <DialogRef Id="ResumeDlg" />
    <DialogRef Id="UserExit" />
    <DialogRef Id="WelcomeDlg" />

    <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" Condition="1" />

    <!-- Khong con man hinh cau hinh nao — Welcome.Next ket thuc UI sequence ngay
         (EndDialog Return) de vao thang Progress. -->
    <Publish Dialog="WelcomeDlg" Control="Next" Event="EndDialog" Value="Return" Order="2" Condition="1" />
    </UI>

  </Package>
</Wix>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Bo cai Windows Installer (.msi) cho DF Local Agent - dong goi bang WiX Toolset v5.
  Dung dinh dang MSI + ServiceInstall/ServiceControl native (khong shell ra sc.exe an cua
  so nhu ban Inno Setup .exe) de giam nguy co bi Windows Defender gan nhan heuristic
  "dropper" (Program:Win32/Wacapew.A!ml) - xem session-log.md muc lien quan toi 404 tai
  cong cu DF Agent (2026-07-29).

  KHONG con man hinh cau hinh, KHONG con Custom Action sinh appsettings.json luc cai (da bo
  sau khi gap MSI error 1721 "A program run as part of the setup did not finish as expected"
  tren may that 2026-07-30 — deferred Custom Action goi PowerShell qua token [~] khong dang
  tin cay bang, kho debug tu xa). Vi StationId da co dong san luc build (khong con nguoi
  dung nhap gi ca), don gian hon nhieu la dong goi THANG 1 file appsettings.scale.json tinh
  co san qua bien tien xu ly AppSettingsFile — khong can Custom Action nao het ngoai
  ServiceInstall/ServiceControl native cua MSI.

  Tu 2026-07-31 chi con DUNG 1 vai tro / 1 file MSI: NHAN CAN (SCALE_ONLY). Truoc do co 3
  vai tro (print-station / weighing-printer / weighing-scale) vi may in di qua Agent; nay ca
  Print Station lan Weighing Station deu in bang hop thoai in cua trinh duyet nen phan may in
  cua Agent khong con duoc dung o dau ca. Build:
    wix build DFAgentSetup.wxs -ext WixToolset.UI.wixext -o DFAgentSetup-Scale.msi
  (xem agent/installer/build.ps1 — script build ca .NET publish lan MSI)

  Khong con Token — backend (AgentAuth middleware) tu tao/nhan Workstation theo
  workstation_id khi khong co token, danh doi bao mat da duoc nguoi dung xac nhan (xem
  session-log.md).
-->
<?ifndef StationId?>
<?define StationId = "WS-WEIGH-SCALE"?>
<?endif?>
<?ifndef AppSettingsFile?>
<?define AppSettingsFile = "appsettings.scale.json"?>
<?endif?>
<?ifndef PackageVersion?>
<!-- 2.1.0.0 (2026-08-01): doi han cach doc can — doc duoi file log PuTTY (Scale:Source=
     PUTTY_LOG, dung cach he Excel VBA cu) o nhip 10ms, tach nhip DOC khoi nhip DAY len
     backend. Phai tang version vi may pilot dang cai 2.0.0.0; giu nguyen so thi MajorUpgrade
     khong nang cap sach duoc.

     2.0.0.0: moc bo 2 vai tro may in, chi con vai tro nhan can. Version cao hon han 1.4.x
     cua ca 3 file MSI cu de may tram da cai bat ky vai tro nao cung nang cap thang len
     duoc (MajorUpgrade tu go ban cu truoc khi cai ban nay). -->
<!-- 2.2.0.0 (2026-08-01): mot bo cai dung cho MOI may — Workstation:Id de trong, Agent tu sinh
     ma tram tu TEN MAY ("WS-SCALE-<TEN-MAY>", xem Worker.ResolveWorkstationId). Truoc do file
     nay dong cung mot ma tram cho moi may nen hai tram can chay cung luc ghi de so can cua
     nhau. Agent gui kem role + machine_name de backend tu tao ban ghi tram dung loai ngay o
     lan day so dau tien (AgentAuth), va trinh duyet tren chinh may do tu nhan ra tram cua minh
     qua /api/workstations/whoami. -->
<?define PackageVersion = "2.2.0.0"?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DF Local Agent ($(var.StationId))"
           Manufacturer="DF Factory Systems"
           Version="$(var.PackageVersion)"
           UpgradeCode="CD108F1A-FCE9-46F2-B991-372D89E0E9D1"
           Language="1033"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <!-- Giu nguyen UpgradeCode cu de bo cai nay TU GO 3 ban 1.4.x cua cac vai tro cu
         (print-station / weighing-printer / weighing-scale) neu may tram da cai — tranh 2
         service cung ten "DFAgent" chong nhau. AllowDowngrades="yes" giu nguyen tu ban cu:
         thu tu version giua cac ban cu khong phan anh "moi/cu" that su. -->
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DFAgent" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="..\publish_release\**">
        <Exclude Files="..\publish_release\DFAgent.exe" />
        <Exclude Files="..\publish_release\appsettings.json" />
      </Files>
    </ComponentGroup>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="57612DD8-1695-4C9D-BA12-50A1C09E972E" Bitness="always64">
      <File Id="DFAgentExe" Source="..\publish_release\DFAgent.exe" KeyPath="yes" />

      <ServiceInstall Id="DFAgentServiceInstall"
                      Name="DFAgent"
                      DisplayName="DF Local Agent"
                      Description="Doc can dien tu qua cong COM va day so can len he thong DF (khong dung dau co dau de tranh loi encoding Service Control Manager)."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem" />

      <ServiceControl Id="DFAgentServiceControl"
                       Name="DFAgent"
                       Start="install"
                       Stop="both"
                       Remove="uninstall"
                       Wait="yes" />
    </Component>

    <!-- appsettings.json tinh, dong san dung role/ma tram theo bien AppSettingsFile luc
         build — khong sinh dong luc cai nua (xem ghi chu dau file). -->
    <Component Id="AppSettingsConfig" Directory="INSTALLFOLDER" Guid="AEDB51B0-A39F-498D-9C25-BF8E612DF1E0" Bitness="always64">
      <File Id="AppSettingsJson" Name="appsettings.json" Source="$(var.AppSettingsFile)" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="DF Local Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppSettingsConfig" />
    </Feature>

    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <UI>
    <UIRef Id="WixUI_Common" />

    <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
    <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
    <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

    <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <DialogRef Id="ErrorDlg" />
    <DialogRef Id="ExitDialog" />
    <DialogRef Id="FatalError" />
    <DialogRef Id="FilesInUse" />
    <DialogRef Id="MsiRMFilesInUse" />
    <DialogRef Id="PrepareDlg" />
    <DialogRef Id="ProgressDlg" />
    <DialogRef Id="ResumeDlg" />
    <DialogRef Id="UserExit" />
    <DialogRef Id="WelcomeDlg" />

    <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" Condition="1" />

    <!-- Khong con man hinh cau hinh nao — Welcome.Next ket thuc UI sequence ngay
         (EndDialog Return) de vao thang Progress. -->
    <Publish Dialog="WelcomeDlg" Control="Next" Event="EndDialog" Value="Return" Order="2" Condition="1" />
    </UI>

  </Package>
</Wix>

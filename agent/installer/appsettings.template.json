{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Backend": {
    "Url": "{{BACKEND_URL}}"
  },
  "Workstation": {
    "Id": "{{WORKSTATION_ID}}",
    "Token": "",
    "Role": "{{WORKSTATION_ROLE}}"
  },
  "Scale": {
    "UseSimulation": true,
    "SimulationFilePath": "{{PUTTY_LOG_PATH}}",
    "PortName": "COM1",
    "BaudRate": 9600,
    "DataBits": 8,
    "PollIntervalMs": 500
  },
  "Printer": {
    "ConnectionType": "USB",
    "Address": "TSC TE200"
  }
}
